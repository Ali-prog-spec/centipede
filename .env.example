# Centipede Web — Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/centipede
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/centipede
MONGODB_URI=mongodb://localhost:27017/centipede

# JWT Secret for authentication (change in production!)
JWT_SECRET=your-secret-key-change-in-production

# Environment
NODE_ENV=development
